{
    "name": "spatie/laravel-newsletter",
    "description": "Manage Mailcoach, MailChimp, MailerLite and Brevo newsletters in Laravel",
    "keywords": [
        "laravel",
        "newsletter",
        "mailcoach",
        "mailchimp",
        "mailerlite",
        "brevo"
    ],
    "homepage": "https://github.com/spatie/laravel-newsletter",
    "license": "MIT",
    "authors": [
        {
            "name": "Freek Van der Herten",
            "email": "freek@spatie.be",
            "homepage": "https://spatie.be",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.13",
        "illuminate/log": "^12.0|^13.0"
    },
    "suggest": {
        "spatie/mailcoach-sdk-php": "For working with Mailcoach",
        "drewm/mailchimp-api": "For working with MailChimp",
        "mailerlite/mailerlite-php": "For working with MailerLite",
        "getbrevo/brevo-php": "For working with Brevo"
    },
    "require-dev": {
        "drewm/mailchimp-api": "^2.5",
        "getbrevo/brevo-php": "^5.0",
        "guzzlehttp/guzzle": "^7.5|^7.2",
        "laravel/pint": "^1.24",
        "mailerlite/mailerlite-php": "^1.0",
        "mockery/mockery": "^1.4",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.1",
        "spatie/mailcoach-sdk-php": "^1.0",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "Spatie\\Newsletter\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spatie\\Newsletter\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spatie\\Newsletter\\NewsletterServiceProvider"
            ],
            "aliases": {
                "Newsletter": "Spatie\\Newsletter\\Facades\\Newsletter"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
